<resources>
    <color name="window_background_light">#FFFFFFFF</color>
    <color name="window_background_dark">#FF1C1B1F</color>

    <style name="AppThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- ALONE VPN — androidx.core.splashscreen theme. The prototype's own comment is explicit that
         a splash is `androidx.core.splashscreen`, not a Composable screen to animate by hand — see
         SPLASH_INTEGRATION.md for the two manual wiring steps (manifest + MainActivity) this needs. -->
    <style name="Theme.AloneVpn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/alone_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/alone_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/alone_splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/AppThemeDayNight.NoActionBar</item>
    </style>
</resources>
